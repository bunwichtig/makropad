              {
                "name": "Realtek",
                "symbol": "lautsprecher",
                "farbe": "#1e6fd9"
              },
              {
                "name": "Sound Blaster",
                "symbol": "headset",
                "farbe": "#e76f00"
              }
            ]
          }
        },
        "5": {
          "name": "Chrome-Fenster links nach vorne",
          "anzeige": {
            "symbol": "browser_links",
            "farbe": "#3c4043"
          },
          "aktion": {
            "typ": "fokus_position",
            "prozess": "chrome.exe",
            "bereich": "links",
            "starten": "chrome.exe"
          }
        },
        "6": {
          "name": "Steam-Freundesliste nach vorne",
          "anzeige": {
            "symbol": "freunde",
            "farbe": "#1b2838"
          },
          "aktion": {
            "typ": "fokus",
            "prozess": "steamwebhelper.exe",
            "titel": [
              "Freunde",
              "Friends"
            ],
            "starten": "steam://open/friends"
          }
        }
      }
