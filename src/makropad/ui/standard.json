          "anzeige": {
            "text": "Discord",
            "farbe": "#5865F2"
          },
          "aktion": {
            "typ": "fokus",
            "prozess": "Discord.exe",
            "starten": "\"%LOCALAPPDATA%\\Discord\\Update.exe\" --processStart Discord.exe"
          }
        },
        "3": {
          "name": "EA App aus dem Tray",
          "anzeige": {
            "text": "EA",
            "farbe": "#ff4747"
          },
          "aktion": {
            "typ": "fokus",
            "prozess": "EADesktop.exe",
            "tray_klick": true,
            "starten": "C:\\Program Files\\Electronic Arts\\EA Desktop\\EA Desktop\\EADesktop.exe"
          }
        },
        "4": {
          "name": "Ausgabe: Boxen / Headset",
          "aktion": {
            "typ": "ausgabe_wechseln",
